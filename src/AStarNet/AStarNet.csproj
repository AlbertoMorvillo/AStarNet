<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>AStarNet</RootNamespace>
    <Authors>Alberto Morvillo</Authors>
    <PackageId>AStar.net</PackageId>
    <Title>AStar.net</Title>
    <Description>AStar.net is a .NET implementation of the A* pathfinding algorithm.</Description>
    <PackageTags>astar;pathfinding;path-finding;graph;algorithm</PackageTags>
    <PackageProjectUrl>https://github.com/AlbertoMorvillo/AStarNet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/AlbertoMorvillo/AStarNet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>AStarLogo_128.png</PackageIcon>
    <VersionPrefix>2.1.0</VersionPrefix>
    <PackageVersion>$(VersionPrefix)</PackageVersion>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <PackageReleaseNotes>Version 2.1.0

    - Added public path construction from node identifiers and incoming connection costs
    - Optimized path construction and concatenation to reduce allocations and unnecessary copies
    - Optimized connection enumeration for arrays and lists while preserving custom IEnumerable behavior
    - Cached heuristic estimates for the duration of each search
    - Fixed reconstructed path costs when equal-cost parent selection changes
    - Clarified node-map and heuristic-provider contracts</PackageReleaseNotes>
    <Copyright>Copyright © 2026 Alberto Morvillo</Copyright>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\branding\logo\AStarLogo_128.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\..\LICENSE" Link="LICENSE">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Update="README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
